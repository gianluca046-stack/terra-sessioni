{
  "name": "TERRA Sessioni",
  "short_name": "TERRA Sessioni",
  "description": "Sessioni GNSS in campagna, dal programma Progetto reti GPS di TERRA",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F3F4F0",
  "theme_color": "#14271E",
  "icons": [
    {
      "src": "icona-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icona-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/json",
            "text/plain",
            "application/octet-stream",
            ".json"
          ]
        }
      ]
    }
  }
}
